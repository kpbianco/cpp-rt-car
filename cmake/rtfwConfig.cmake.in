@PACKAGE_INIT@

set(RTFW_PREFIX "${PACKAGE_PREFIX_DIR}")
set_and_check(RTFW_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(RTFW_INCLUDE_DIRS "${RTFW_INCLUDE_DIR}")
set_and_check(RTFW_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/rtfw")
set(RTFW_VERSION "@PROJECT_VERSION@")
set(RTFW_C_ABI_VERSION "@RTFW_C_ABI_VERSION@")
set(RTFW_C_ABI_MIN_COMPATIBLE_VERSION
    "@RTFW_C_ABI_MIN_COMPATIBLE_VERSION@")
set(RTFW_WITH_CUDA_DRIVER "@RTFW_ENABLE_CUDA@")
set(RTFW_WITH_XDMA_LINUX "@RTFW_ENABLE_XDMA@")
set(RTFW_WITH_EXPERIMENTAL "@RTFW_INSTALL_EXPERIMENTAL@")

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/rtfwTargets.cmake")

set(rtfw_c_shared_FOUND FALSE)
if (TARGET rtfw::c_shared AND TARGET rtfw::rtfw)
    set(rtfw_c_shared_FOUND TRUE)
endif()
set(rtfw_c_static_FOUND FALSE)
if (TARGET rtfw::c_static AND TARGET rtfw::rtfw_static)
    set(rtfw_c_static_FOUND TRUE)
endif()
set(rtfw_runtime_FOUND FALSE)
if (TARGET rtfw::runtime)
    set(rtfw_runtime_FOUND TRUE)
endif()
set(rtfw_cpp_runtime_FOUND FALSE)
if (TARGET rtfw::runtime AND TARGET rtfw::simcore_rt)
    set(rtfw_cpp_runtime_FOUND TRUE)
endif()
set(rtfw_cuda_backend_FOUND FALSE)
if (TARGET rtfw::cuda_backend)
    set(rtfw_cuda_backend_FOUND TRUE)
endif()
set(rtfw_cuda_driver_FOUND FALSE)
if ("cuda_driver" IN_LIST rtfw_FIND_COMPONENTS AND
    RTFW_WITH_CUDA_DRIVER)
    if (rtfw_FIND_REQUIRED_cuda_driver)
        find_dependency(CUDAToolkit)
    else()
        find_package(CUDAToolkit QUIET)
    endif()
    if (CUDAToolkit_FOUND AND TARGET CUDA::cuda_driver)
        include("${CMAKE_CURRENT_LIST_DIR}/rtfwCudaTargets.cmake")
        if (TARGET rtfw::cuda_driver)
            set(rtfw_cuda_driver_FOUND TRUE)
        endif()
    endif()
endif()
set(rtfw_xdma_backend_FOUND FALSE)
if (TARGET rtfw::xdma_backend)
    set(rtfw_xdma_backend_FOUND TRUE)
endif()
set(rtfw_xdma_linux_FOUND FALSE)
if ("xdma_linux" IN_LIST rtfw_FIND_COMPONENTS AND
    RTFW_WITH_XDMA_LINUX)
    include("${CMAKE_CURRENT_LIST_DIR}/rtfwXdmaTargets.cmake")
    if (TARGET rtfw::xdma_linux)
        set(rtfw_xdma_linux_FOUND TRUE)
    endif()
endif()
set(rtfw_experimental_FOUND FALSE)
if ("experimental" IN_LIST rtfw_FIND_COMPONENTS AND
    RTFW_WITH_EXPERIMENTAL)
    include("${CMAKE_CURRENT_LIST_DIR}/rtfwExperimentalTargets.cmake")
    if (TARGET rtfw::experimental)
        set(rtfw_experimental_FOUND TRUE)
    endif()
endif()

check_required_components(rtfw)
