@PACKAGE_INIT@

set_and_check(RTFW_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(RTFW_INCLUDE_DIRS "${RTFW_INCLUDE_DIR}")
set(RTFW_VERSION "@PROJECT_VERSION@")
set(RTFW_C_ABI_VERSION "@RTFW_C_ABI_VERSION@")
set(RTFW_C_ABI_MIN_COMPATIBLE_VERSION
    "@RTFW_C_ABI_MIN_COMPATIBLE_VERSION@")
set(RTFW_WITH_CUDA_DRIVER "@RTFW_ENABLE_CUDA@")
set(RTFW_WITH_XDMA_LINUX "@RTFW_ENABLE_XDMA@")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if (RTFW_WITH_CUDA_DRIVER)
    find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rtfwTargets.cmake")

set(rtfw_c_shared_FOUND FALSE)
if (TARGET rtfw::rtfw)
    set(rtfw_c_shared_FOUND TRUE)
endif()
set(rtfw_c_static_FOUND FALSE)
if (TARGET rtfw::rtfw_static)
    set(rtfw_c_static_FOUND TRUE)
endif()
set(rtfw_cpp_runtime_FOUND FALSE)
if (TARGET rtfw::simcore_rt)
    set(rtfw_cpp_runtime_FOUND TRUE)
endif()
set(rtfw_cuda_backend_FOUND FALSE)
if (TARGET rtfw::cuda_backend)
    set(rtfw_cuda_backend_FOUND TRUE)
endif()
set(rtfw_cuda_driver_FOUND FALSE)
if (TARGET rtfw::cuda_driver)
    set(rtfw_cuda_driver_FOUND TRUE)
endif()
set(rtfw_xdma_backend_FOUND FALSE)
if (TARGET rtfw::xdma_backend)
    set(rtfw_xdma_backend_FOUND TRUE)
endif()
set(rtfw_xdma_linux_FOUND FALSE)
if (TARGET rtfw::xdma_linux)
    set(rtfw_xdma_linux_FOUND TRUE)
endif()

check_required_components(rtfw)
