{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Autotune runtime configuration",
  "type": "object",
  "required": [
    "threads",
    "chunking",
    "layout",
    "prefetch",
    "scheduler",
    "governor",
    "numerics",
    "memory",
    "tracing"
  ],
  "properties": {
    "threads": {
      "type": ["string", "integer"]
    },
    "chunking": {
      "type": "object",
      "required": [
        "target_p90_us",
        "min_items",
        "max_items"
      ],
      "properties": {
        "target_p90_us": {"type": "integer"},
        "min_items": {"type": "integer"},
        "max_items": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": [
        "aosoa_block",
        "align_bytes",
        "pad_to_simd"
      ],
      "properties": {
        "aosoa_block": {"type": "integer"},
        "align_bytes": {"type": "integer"},
        "pad_to_simd": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "prefetch": {
      "type": "object",
      "required": [
        "enabled",
        "distance_bytes"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "distance_bytes": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "scheduler": {
      "type": "object",
      "required": [
        "steal_threshold",
        "emergency_spawn"
      ],
      "properties": {
        "steal_threshold": {"type": "integer"},
        "emergency_spawn": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "governor": {
      "type": "object",
      "required": [
        "target_util",
        "hysteresis"
      ],
      "properties": {
        "target_util": {"type": "number"},
        "hysteresis": {"type": "number"}
      },
      "additionalProperties": true
    },
    "numerics": {
      "type": "object",
      "required": [
        "ftz_daz",
        "fma"
      ],
      "properties": {
        "ftz_daz": {"type": "boolean"},
        "fma": {"type": "string"}
      },
      "additionalProperties": true
    },
    "memory": {
      "type": "object",
      "required": [
        "huge_pages",
        "arena_per_thread_mb",
        "numa",
        "pretouch"
      ],
      "properties": {
        "huge_pages": {"type": "boolean"},
        "arena_per_thread_mb": {"type": "integer"},
        "numa": {"type": "string"},
        "pretouch": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "tracing": {
      "type": "object",
      "required": ["bintrace"],
      "properties": {
        "bintrace": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "params": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
