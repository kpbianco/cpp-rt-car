{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RTFW resolved runtime profile",
  "description": "Authoring schema for the allocation-free rt::Runtime profile loader in RTFW 1.2.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "runtime_compatibility",
    "runtime_config_schema",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9._:/@-]+$"
    },
    "runtime_compatibility": {
      "type": "object",
      "required": [
        "major",
        "minimum_minor"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "const": 1
        },
        "minimum_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "runtime_config_schema": {
      "type": "integer",
      "const": 7
    },
    "runtime": {
      "type": "object",
      "required": [
        "callback_capacity",
        "scratch_bytes",
        "trace_capacity",
        "numerical_mode",
        "executor_policy",
        "worker_count",
        "executor_queue_capacity",
        "scratch_alignment",
        "task_scratch_bytes",
        "task_scratch_slots",
        "memory_budget_bytes",
        "overload_policy",
        "watchdog_timeout_ns",
        "watchdog_max_degradation_level",
        "platform_preflight_mode",
        "determinism_tier",
        "state_capacity",
        "snapshot_max_bytes",
        "replay_input_capacity",
        "input_log_max_bytes",
        "device_backend_capacity",
        "device_buffer_capacity",
        "device_outstanding_capacity",
        "device_completion_batch",
        "workload_id"
      ],
      "properties": {
        "callback_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "scratch_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "trace_capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "numerical_mode": {
          "type": "string",
          "enum": [
            "precise",
            "fused_multiply_add"
          ]
        },
        "executor_policy": {
          "type": "string",
          "enum": [
            "static_deterministic",
            "bounded_throughput",
            "host_adapter"
          ]
        },
        "worker_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "executor_queue_capacity": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1048576
        },
        "scratch_alignment": {
          "type": "integer",
          "enum": [
            16,
            32,
            64,
            128,
            256,
            512,
            1024,
            2048,
            4096
          ]
        },
        "task_scratch_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "task_scratch_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "memory_budget_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "overload_policy": {
          "type": "string",
          "enum": [
            "reject_submission",
            "fail_frame"
          ]
        },
        "watchdog_timeout_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000000000
        },
        "watchdog_max_degradation_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "platform_preflight_mode": {
          "type": "string",
          "enum": [
            "disabled",
            "strict"
          ]
        },
        "determinism_tier": {
          "type": "string",
          "enum": [
            "d0",
            "d1"
          ]
        },
        "state_capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "snapshot_max_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1073741824
        },
        "replay_input_capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "input_log_max_bytes": {
          "type": "integer",
          "minimum": 192,
          "maximum": 1073741824
        },
        "device_backend_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "device_buffer_capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "device_outstanding_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "device_completion_batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9._:/@-]+$"
        }
      },
      "additionalProperties": false
    },
    "params": {
      "description": "Opaque experiment provenance; ignored by the runtime after bounded JSON validation.",
      "type": "object"
    }
  },
  "additionalProperties": false
}
