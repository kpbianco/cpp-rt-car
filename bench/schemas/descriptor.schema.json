{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtfw.local/benchmark/descriptor-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "clock",
    "comparison_policy",
    "configuration",
    "counters",
    "evidence_class",
    "implementation",
    "parameters",
    "provider_id",
    "provider_version",
    "raw_policy",
    "repetitions",
    "schema_version",
    "subsystem",
    "unit",
    "warmup",
    "workload_kind",
    "workload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "provider_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "subsystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "implementation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "configuration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "workload_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "workload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maximum",
          "minimum",
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "minimum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "maximum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      }
    },
    "counters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "maximum",
          "minimum",
          "name",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minimum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "maximum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      }
    },
    "clock": {
      "enum": [
        "fake",
        "steady"
      ]
    },
    "unit": {
      "const": "ns"
    },
    "comparison_policy": {
      "const": "none"
    },
    "evidence_class": {
      "enum": [
        "structural_fixture",
        "portable_characterization"
      ]
    },
    "raw_policy": {
      "const": "all_measured"
    },
    "warmup": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
