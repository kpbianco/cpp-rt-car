{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/contracts/ci-diagnosis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "confidence", "causal_failure", "evidence", "recommended_repair", "safe_for_pr_fix"],
  "properties": {
    "classification": {"enum": ["product-defect", "test-defect", "flake", "dependency-environment", "workflow-config", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "causal_failure": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommended_repair": {"type": "string"},
    "required_validation": {"type": "array", "items": {"type": "string"}},
    "safe_for_pr_fix": {"type": "boolean"}
  }
}
