{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/contracts/automation.schema.json",
  "title": "Portfolio roadmap automation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "control_repository",
    "target_repository",
    "target_path",
    "profile",
    "default_branch",
    "verification_command",
    "batches"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "product": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "control_repository": {"type": "string", "minLength": 3},
    "target_repository": {"type": "string", "minLength": 3},
    "target_path": {"type": "string", "minLength": 1},
    "profile": {
      "enum": [
        "assurance",
        "asset-production",
        "product-data",
        "hardware-embedded",
        "rapid-prototype"
      ]
    },
    "default_branch": {"type": "string", "minLength": 1},
    "default_mode": {
      "enum": ["pr-only", "review-only", "merge-software"]
    },
    "contract_mode": {
      "enum": ["pr-only", "merge-software"]
    },
    "target_merge_policy": {
      "enum": ["automatic", "human-review"]
    },
    "merge_strategy": {"enum": ["merge", "rebase", "squash"]},
    "verification_command": {"type": "string", "minLength": 1},
    "harness_verification_commands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "onboarding_verification_mode": {
      "enum": ["standard", "hold-safe-structural"]
    },
    "hold_safe_onboarding_source": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "preserve_harness_revision_while_active_batch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "mode"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {"type": "string", "minLength": 1},
          "mode": {
            "enum": ["software", "environment", "hardware", "manual"]
          },
          "reason": {"type": "string"},
          "requires_env": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "supervisor_authorization": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "scope"],
            "properties": {
              "reference": {"type": "string", "minLength": 1},
              "scope": {"type": "string", "minLength": 1}
            }
          },
          "gate_only": {"type": "boolean"},
          "gate_command": {"type": "string", "minLength": 1},
          "selected_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "scope_hint": {"type": "string", "minLength": 1}
        }
      }
    },
    "dynamic_authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "insert_after",
        "coverage_report",
        "id_prefix",
        "id_field",
        "domain_field",
        "status_field",
        "incomplete_statuses",
        "mode",
        "minimum_batch_size",
        "maximum_batch_size"
      ],
      "properties": {
        "insert_after": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "coverage_report": {"type": "string", "minLength": 1},
        "id_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "id_field": {"type": "string", "minLength": 1},
        "domain_field": {"type": "string", "minLength": 1},
        "name_field": {"type": "string", "minLength": 1},
        "status_field": {"type": "string", "minLength": 1},
        "incomplete_statuses": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "mode": {
          "enum": ["software", "environment", "hardware", "manual"]
        },
        "minimum_batch_size": {"type": "integer", "minimum": 1},
        "maximum_batch_size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
