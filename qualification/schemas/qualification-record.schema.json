{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtfw.dev/qualification/qualification-record.schema.json",
  "title": "RTFW qualification record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "evidence_class", "campaign_id", "tuple_id", "scope", "plan_sha256", "source", "host", "topology", "policy", "workload", "accelerator", "started_at", "ended_at", "artifact_manifest", "evidence_manifest_sha256", "raw_populations", "resource_trends", "thermal_trends", "device_health", "trials", "thresholds", "overall_result"],
  "properties": {
    "schema_version": {"const": 1},
    "document_type": {"const": "qualification_record"},
    "evidence_class": {"enum": ["synthetic_fixture", "qualification_campaign"]},
    "campaign_id": {"$ref": "#/$defs/identifier"},
    "tuple_id": {"$ref": "#/$defs/identifier"},
    "scope": {"enum": ["nvidia", "xdma", "combined", "rt1", "rt2"]},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "build_id", "product_version"], "properties": {"commit": {"$ref": "#/$defs/commit"}, "build_id": {"$ref": "#/$defs/identifier"}, "product_version": {"type": "string", "minLength": 5, "maxLength": 32}}},
    "host": {"$ref": "#/$defs/host"},
    "topology": {"$ref": "#/$defs/topology"},
    "policy": {"$ref": "#/$defs/policy"},
    "workload": {"type": "object", "additionalProperties": false, "required": ["id", "input_id", "input_sha256"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "input_id": {"$ref": "#/$defs/identifier"}, "input_sha256": {"$ref": "#/$defs/sha256"}}},
    "accelerator": {"$ref": "#/$defs/accelerator"},
    "started_at": {"$ref": "#/$defs/time"},
    "ended_at": {"$ref": "#/$defs/time"},
    "artifact_manifest": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}},
    "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "raw_populations": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "object", "additionalProperties": false, "required": ["id", "artifact_path"], "properties": {"id": {"enum": ["release", "wake", "compute", "submit", "poll", "completion", "slack", "miss", "temperature", "clock", "power", "memory", "queue", "error", "recovery"]}, "artifact_path": {"$ref": "#/$defs/path"}}}},
    "resource_trends": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/trend"}},
    "thermal_trends": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/trend"}},
    "device_health": {"type": "object", "additionalProperties": false, "required": ["healthy", "losses", "recovered"], "properties": {"healthy": {"type": "boolean"}, "losses": {"type": "integer", "minimum": 0, "maximum": 10000000}, "recovered": {"type": "boolean"}}},
    "trials": {"type": "array", "minItems": 7, "maxItems": 64, "items": {"$ref": "#/$defs/trial_result"}},
    "thresholds": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/threshold_result"}},
    "overall_result": {"enum": ["pass", "fail"]}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1024},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\\\:/]+(?:/[^\\\\:/]+)*$"},
    "kernel": {"type": "object", "additionalProperties": false, "required": ["version", "configuration_sha256", "boot_parameters"], "properties": {"version": {"$ref": "#/$defs/text"}, "configuration_sha256": {"$ref": "#/$defs/sha256"}, "boot_parameters": {"$ref": "#/$defs/text"}}},
    "host": {"type": "object", "additionalProperties": false, "required": ["cpu", "motherboard", "bios_firmware", "memory", "operating_system", "kernel", "compiler"], "properties": {"cpu": {"$ref": "#/$defs/text"}, "motherboard": {"$ref": "#/$defs/text"}, "bios_firmware": {"$ref": "#/$defs/text"}, "memory": {"$ref": "#/$defs/text"}, "operating_system": {"$ref": "#/$defs/text"}, "kernel": {"$ref": "#/$defs/kernel"}, "compiler": {"$ref": "#/$defs/text"}}},
    "topology": {"type": "object", "additionalProperties": false, "required": ["numa", "iommu", "irq", "power"], "properties": {"numa": {"$ref": "#/$defs/text"}, "iommu": {"$ref": "#/$defs/text"}, "irq": {"$ref": "#/$defs/text"}, "power": {"$ref": "#/$defs/text"}}},
    "rt2": {"type": "object", "additionalProperties": false, "required": ["applicable", "preempt_rt", "isolation", "irq_placement", "scheduling", "locking"], "properties": {"applicable": {"type": "boolean"}, "preempt_rt": {"type": "boolean"}, "isolation": {"$ref": "#/$defs/text"}, "irq_placement": {"$ref": "#/$defs/text"}, "scheduling": {"$ref": "#/$defs/text"}, "locking": {"$ref": "#/$defs/text"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["runtime", "threads", "memory", "time", "measured_host_policy", "rt2"], "properties": {"runtime": {"$ref": "#/$defs/text"}, "threads": {"$ref": "#/$defs/text"}, "memory": {"$ref": "#/$defs/text"}, "time": {"$ref": "#/$defs/text"}, "measured_host_policy": {"$ref": "#/$defs/text"}, "rt2": {"$ref": "#/$defs/rt2"}}},
    "nvidia": {"type": "object", "additionalProperties": false, "required": ["gpu", "pci_bdf", "pcie_link", "cuda_driver", "cuda_toolkit", "firmware", "power_policy", "clock_policy"], "properties": {"gpu": {"$ref": "#/$defs/text"}, "pci_bdf": {"$ref": "#/$defs/text"}, "pcie_link": {"$ref": "#/$defs/text"}, "cuda_driver": {"$ref": "#/$defs/text"}, "cuda_toolkit": {"$ref": "#/$defs/text"}, "firmware": {"$ref": "#/$defs/text"}, "power_policy": {"$ref": "#/$defs/text"}, "clock_policy": {"$ref": "#/$defs/text"}}},
    "xdma": {"type": "object", "additionalProperties": false, "required": ["fpga_part", "pci_bdf", "pcie_link", "driver_revision", "module_parameters", "firmware_or_bitstream_sha256", "ip_configuration", "memory_map"], "properties": {"fpga_part": {"$ref": "#/$defs/text"}, "pci_bdf": {"$ref": "#/$defs/text"}, "pcie_link": {"$ref": "#/$defs/text"}, "driver_revision": {"$ref": "#/$defs/text"}, "module_parameters": {"$ref": "#/$defs/text"}, "firmware_or_bitstream_sha256": {"$ref": "#/$defs/sha256"}, "ip_configuration": {"$ref": "#/$defs/text"}, "memory_map": {"$ref": "#/$defs/text"}}},
    "host_staging": {"type": "object", "additionalProperties": false, "required": ["path", "direct_peer_dma"], "properties": {"path": {"$ref": "#/$defs/text"}, "direct_peer_dma": {"const": false}}},
    "accelerator": {"type": "object", "additionalProperties": false, "properties": {"nvidia": {"$ref": "#/$defs/nvidia"}, "xdma": {"$ref": "#/$defs/xdma"}, "host_staging": {"$ref": "#/$defs/host_staging"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "size_bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "trend": {"type": "object", "additionalProperties": false, "required": ["id", "start", "end", "maximum", "stable"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "start": {"type": "number"}, "end": {"type": "number"}, "maximum": {"type": "number"}, "stable": {"type": "boolean"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["attempted", "success", "details"], "properties": {"attempted": {"type": "boolean"}, "success": {"type": "boolean"}, "details": {"$ref": "#/$defs/text"}}},
    "trial_result": {"type": "object", "additionalProperties": false, "required": ["id", "status", "artifact_path", "recovery"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "status": {"enum": ["pass", "fail", "unsupported", "not_applicable"]}, "artifact_path": {"type": ["string", "null"], "maxLength": 512}, "recovery": {"$ref": "#/$defs/recovery"}}},
    "threshold_definition": {"type": "object", "additionalProperties": false, "required": ["id", "metric", "unit", "population", "statistic", "comparison", "bound", "miss_allowance", "error_allowance"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "metric": {"$ref": "#/$defs/identifier"}, "unit": {"$ref": "#/$defs/identifier"}, "population": {"$ref": "#/$defs/identifier"}, "statistic": {"$ref": "#/$defs/identifier"}, "comparison": {"enum": ["le", "lt", "ge", "gt", "eq"]}, "bound": {"type": "number"}, "miss_allowance": {"type": "integer", "minimum": 0, "maximum": 10000000}, "error_allowance": {"type": "integer", "minimum": 0, "maximum": 10000000}}},
    "threshold_result": {"type": "object", "additionalProperties": false, "required": ["id", "definition", "observed", "misses", "errors", "passed"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "definition": {"$ref": "#/$defs/threshold_definition"}, "observed": {"type": "number"}, "misses": {"type": "integer", "minimum": 0, "maximum": 10000000}, "errors": {"type": "integer", "minimum": 0, "maximum": 10000000}, "passed": {"type": "boolean"}}}
  }
}
