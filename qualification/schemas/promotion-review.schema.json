{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtfw.dev/qualification/promotion-review.schema.json",
  "title": "RTFW qualification promotion review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "evidence_class", "scope", "tuple_id", "plan_sha256", "record_sha256", "evidence_manifest_sha256", "reviewer", "reviewed_at", "decision", "rationale", "exceptions", "pre_run_provenance_verified", "reviewer_authentication"],
  "properties": {
    "schema_version": {"const": 1},
    "document_type": {"const": "promotion_review"},
    "evidence_class": {"enum": ["synthetic_fixture", "qualification_campaign"]},
    "scope": {"enum": ["nvidia", "xdma", "combined", "rt1", "rt2"]},
    "tuple_id": {"$ref": "#/$defs/identifier"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"$ref": "#/$defs/identifier"},
    "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "decision": {"enum": ["pass", "reject"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 1024},
    "exceptions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/exception"}},
    "pre_run_provenance_verified": {"type": "boolean"},
    "reviewer_authentication": {"const": "attribution_only"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exception": {"type": "object", "additionalProperties": false, "required": ["id", "resolved", "rationale"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "resolved": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1, "maxLength": 1024}}}
  }
}
